&lt;a href="https://hk.on.cc/hk/bkn/cnt/finance/20261127/bkn-20261127050036801-1127_00842_001.html"&gt;https://hk.on.cc/hk/bkn/cnt/finance/20261127/bkn-20261127050036801-1127_00842_001.html&lt;/a&gt;&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;br/&gt; &lt;!-- google_ad_section_end --&gt;
&lt;/div&gt;</description>
      <guid isPermaLink="true">https://www.discuss.com.hk/viewthread.php?tid=32353656</guid>

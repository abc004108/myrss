    <item>
      <title>星期一入100萬883中海油</title>
      <link>https://www.discuss.com.hk/viewthread.php?tid=32354482</link>
      <category>關於我們</category>
      <description>&lt;p&gt;Published on: 2026-11-28T20:36:58+0800&lt;/p&gt;&lt;div&gt;
&lt;!-- google_ad_section_start --&gt;

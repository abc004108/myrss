&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4105000/4106728/476834343_1173236190829901_2515245566937105961_n_1200.jpg" media="(min-width: 1200px)"/&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4105000/4106728/476834343_1173236190829901_2515245566937105961_n_600.jpg" media="(min-width: 992px)"/&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4105000/4106728/476834343_1173236190829901_2515245566937105961_n_1024.jpg" media="(min-width: 630px)"/&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4105000/4106728/476834343_1173236190829901_2515245566937105961_n_600.jpg" media="(min-width: 330px)"/&gt;

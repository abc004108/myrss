&lt;div class="grouped-image-wrapper"&gt;
&lt;div class="article-detail_grouped-image block"&gt;
&lt;picture class="image-gallery-img"&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4085000/4089903/1740365906420_600.jpg" media="(min-width: 1200px)"/&gt;

&lt;div class="grouped-image-wrapper"&gt;
&lt;div class="article-detail_grouped-image block"&gt;
&lt;picture class="image-gallery-img"&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4105000/4109985/TVB20260404_00_000006192_600.jpg" media="(min-width: 1200px)"/&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4105000/4109985/TVB20260404_00_000006192_300.jpg" media="(min-width: 1024px)"/&gt;

&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4070000/4071158/2026-01-20091525_600.png" media="(min-width: 992px)"/&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4070000/4071158/2026-01-20091525_1024.png" media="(min-width: 630px)"/&gt;

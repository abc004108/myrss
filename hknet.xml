&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4140000/4144874/Screenshot2026-06-11151339_1_600.png" media="(min-width: 992px)"/&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4140000/4144874/Screenshot2026-06-11151339_1_1024.png" media="(min-width: 630px)"/&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4140000/4144874/Screenshot2026-06-11151339_1_600.png" media="(min-width: 330px)"/&gt;

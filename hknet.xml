&lt;img alt="" class="lazyload" data-alt="《醉拳II》" data-link="" data-src="https://static04.hket.com/res/v3/image/content/4090000/4090962/y20260228_005_1_1_1200.jpg" src="https://static04.hket.com/res/v3/image/content/4090000/4090962/y20260228_005_1_1_1200.jpg" style="max-width:100%; height:auto;"/&gt;

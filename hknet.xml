&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4095000/4096699/Screenshot2026-03-12163301_1024.png" media="(min-width: 630px)"/&gt;
&lt;source data-srcset="https://static04.hket.com/res/v3/image/content/4095000/4096699/Screenshot2026-03-12163301_600.png" media="(min-width: 330px)"/&gt;
